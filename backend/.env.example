# CyberCISO Environment Configuration
# Copy this file to .env and fill in your values.
# The app works in MOCK MODE (no API key needed) if GROQ_API_KEY is empty.

# ── Backend ──────────────────────────────────────────────
# Groq API key (leave empty to run in mock mode with simulated responses)
GROQ_API_KEY=

# Preferred model — the app auto-downgrades to other free-tier models
# when this one hits rate limits. Fallback chain:
#   llama-3.1-8b-instant -> llama-3.3-70b-versatile -> qwen/qwen3-32b
#   -> llama-4-scout -> gpt-oss-20b -> gpt-oss-120b
GROQ_MODEL=qwen/qwen3.6-27b

# Max tokens per response
GROQ_MAX_TOKENS=4096

# Prompt compression threshold (tokens) — compress when conversation exceeds this
TOKEN_THRESHOLD=3000

# Target token budget after compression
TARGET_TOKEN_BUDGET=2000

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development

# ── Frontend ─────────────────────────────────────────────
# URL the frontend uses to reach the backend API
NEXT_PUBLIC_API_URL=http://localhost:8000
